# 默认模式完全离线、结果确定，不会发送任何网络请求。
AI_PROVIDER=mock
AI_SERVICE_VERSION=0.1.0
AI_DEFAULT_TIMEOUT_MS=1500
AI_DEFAULT_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=10000

# OpenAI-compatible 默认仍断网。只有同时选择 Provider 并把下列开关改为 true，
# 通过 HTTPS/主机白名单/模型/密钥校验后才会向配置的端点发送当前请求正文。
# 不要把真实密钥写回或提交到仓库；只在本机 shell、密钥管理器或 CI Secret 中注入。
AI_OPENAI_NETWORK_ENABLED=false
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=replace-me
AI_OPENAI_API_KEY=
# 逗号分隔；防止把用户输入拼成任意地址而造成 SSRF。
AI_OPENAI_ALLOWED_HOSTS=api.openai.com
AI_OPENAI_TIMEOUT_MS=10000
AI_OPENAI_MAX_OUTPUT_TOKENS=1000
AI_OPENAI_MAX_RESPONSE_BYTES=1000000
